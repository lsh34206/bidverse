# 복사해서 backend/.env 로 쓴다. 실제 값은 저장소에 올리지 말 것 (.env 는 .gitignore 에 들어 있음).

# ── 기본 ──────────────────────────────────────────────
PORT=3000
# 프론트와 API가 같은 도메인(nginx)이면 CORS는 쓰이지 않는다. 다른 도메인이면 프론트 주소.
CORS_ORIGIN=http://localhost:5173
# nginx 한 단 뒤에서 운영할 때 1 (X-Forwarded-For 의 실제 클라이언트 IP 사용 — 속도 제한이 IP 기준)
# TRUST_PROXY=1

# ── MongoDB ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/bidverse
# 접속 문자열의 DB 이름 대신 쓸 이름 (보통 비워 둔다)
# MONGODB_DB=
# MONGODB_POOL_MAX=50

# ── 인증 ──────────────────────────────────────────────
# 충분히 긴 무작위 문자열. 바꾸면 발급된 로그인 토큰이 모두 무효가 된다.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Redis (선택) ──────────────────────────────────────
# 서버 인스턴스를 2개 이상 띄울 때 필수 (ecosystem.config.cjs 의 API_INSTANCES 참고).
# Socket.IO 이벤트를 인스턴스 간에 전달하고 속도 제한 카운터를 공유한다.
# REDIS_URL=redis://127.0.0.1:6379

# ── 토스페이먼츠 결제 ─────────────────────────────────
# 개발자센터 > API 키 > "결제위젯 연동 키" (주문서형·결제창형). 키 쌍은 test_ 끼리, live_ 끼리 써야 한다.
#   클라이언트 키: test_gck_... / live_gck_...  (브라우저에 내려가도 되는 공개 키)
#   시크릿 키:     test_gsk_... / live_gsk_...  (서버 전용. 절대 프론트·저장소·로그에 노출 금지)
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# 키가 둘 다 없으면: 개발 환경은 '모의 결제'로 동작하고, 운영(NODE_ENV=production)은 결제가 막힌다.
# PAYMENT_MOCK=false   # 개발 환경에서도 모의 결제를 끄고 싶을 때
# 웹훅 URL(개발자센터에 등록): https://<도메인>/api/payments/webhook

# ── 테스트/부하 테스트 전용 (운영에서는 설정하지 않는다) ─
# THROTTLE_DISABLED=true
# DISABLE_SCHEDULERS=true
